{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "CloudResume": "AccountEndpoint=https://<your-cosmos>.documents.azure.com:443/;AccountKey=<key>;",

    "_comment": "Optional. Unset = the matching code path no-ops (Turnstile passes, no email sent).",
    "TURNSTILE_SECRET": "",
    "ACS_CONNECTION_STRING": "",
    "NOTIFY_SENDER_ADDRESS": "DoNotReply@<guid>.azurecomm.net",
    "NOTIFY_EMAIL": "you@example.com"
  },
  "Host": {
    "CORS": "*"
  }
}
